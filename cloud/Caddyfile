# The front door of an AT-SUITE cloud server: https://<venue>.<domain> → that venue's container.
# atcloud writes one file per venue into sites/ and reloads; nothing here changes per venue.
# Cloudflare sits in front: it holds the public certificate, and this server uses a Cloudflare
# origin certificate (certs/origin.pem and origin.key) for the hop from Cloudflare to here.
{
	admin localhost:2019
	auto_https disable_redirects # only 443 is open; Cloudflare sends everyone to https
	servers {
		# Visitors' real addresses come from Cloudflare (atcloud init --cloudflare lists its ranges).
		trusted_proxies static {$ATCLOUD_TRUSTED_PROXIES}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# Only Cloudflare may connect (Docker's published ports go round the server's own firewall).
(cloudflare_only) {
	@outside not remote_ip {$ATCLOUD_TRUSTED_PROXIES}
	handle @outside {
		abort
	}
}

*.{$ATCLOUD_DOMAIN} {
	tls /certs/origin.pem /certs/origin.key
	import cloudflare_only
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	import /etc/caddy/sites/*.caddy
	handle {
		header Content-Type "text/plain; charset=utf-8"
		respond "There's no AT-SUITE venue at this address." 404
	}
}

# Other sites on this server, such as the website and shop on their own domain: one file each in
# /srv/atcloud/extra (see "Other sites on the same server" in docs/HOSTING.md).
import /etc/caddy/extra/*.caddy
