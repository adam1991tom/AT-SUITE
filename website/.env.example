# AT SUITE shop settings. Copy to .env and fill in. Never commit .env.
# Anything secret can instead be put in a file and pointed at with NAME_FILE (e.g. STRIPE_SECRET_KEY_FILE).

# The public address of the site, with https:// once it's live.
SITE_URL=http://localhost:8090
# Where the database and the Stripe price list live.
SHOP_DATA=./data
# 48 random characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SHOP_SECRET=
# 1 only on your own computer: allows a short SHOP_SECRET.
SHOP_DEV=

# ---- Stripe ----
# Test mode while testing; live once live billing is approved. The key says which mode it is:
# sk_test_... (or a restricted rk_test_...) in test mode, sk_live_.../rk_live_... live. A live key also needs
# SHOP_ALLOW_LIVE=yes, or the shop refuses to start.
# Stripe → Developers → API keys → Secret key. Server only; never put it in a page. Or STRIPE_SECRET_KEY_FILE.
# (The publishable key, pk_..., isn't needed: checkout and the billing portal are Stripe's own pages.)
STRIPE_SECRET_KEY=
SHOP_ALLOW_LIVE=
# The webhook endpoint for https://<your domain>/webhooks/stripe → Signing secret (whsec_...).
# `python3 tools/stripe_setup.py --apply --webhook https://<your domain>/webhooks/stripe` makes the endpoint
# and prints it. For a test on your own computer, `stripe listen --forward-to localhost:8090/webhooks/stripe`
# prints one too. Or STRIPE_WEBHOOK_SECRET_FILE.
STRIPE_WEBHOOK_SECRET=
# yes: Stripe Tax works out VAT and adds it at checkout. Leave it off until you're registered for VAT
# and have added the registration in Stripe → Tax.
STRIPE_TAX=
# yes (default): webhooks are only accepted from the addresses Stripe publishes
# (https://stripe.com/files/ips/ips_webhooks.json). Set no for `stripe listen` on your own computer.
STRIPE_WEBHOOK_IP_CHECK=yes

# ---- Licence keys ----
# The vendor PRIVATE key that signs AT SUITE licence keys (the pair of server/atsuit/vendor_pubkey.txt).
# A file readable only by the shop (chmod 600), outside the repo. Docker: see docker-compose.yml.
LICENCE_SIGNING_KEY_FILE=

# ---- Admin ----
# Who can open /admin (comma-separated). They sign in like customers, then with a 6-digit app code.
ADMIN_EMAILS=adam.tomlinson@atsuite.tech
# Other addresses that sign in to the same account (other=account,…). The sign-in link goes to the
# address typed; it opens the account, so an admin's other address is the same admin.
EMAIL_ALIASES=adam.tomlinson@outlook.com=adam.tomlinson@atsuite.tech

# ---- Email ----
# With no SMTP_HOST nothing is sent: emails wait in Admin → Emails. Any SMTP service works
# (Postmark, Brevo, Microsoft 365...). Sign-in links are sent by email, so set this before launch.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=yes
# Automated emails (sign-in links, licence keys, receipts) come from noreply@; replies go to SUPPORT_EMAIL.
# SALES_EMAIL is the general enquiries address on the contact page.
MAIL_FROM=AT SUITE <noreply@atsuite.tech>
SUPPORT_EMAIL=support@atsuite.tech
SALES_EMAIL=hello@atsuite.tech
# Your trading name, shown in the footer and legal pages.
COMPANY_NAME=[COMPANY NAME] Ltd

# ---- Managed hosting (cloud/atcloud on the hosting server) ----
# manual: venue jobs wait in Admin → Hosting with the command to run. ssh: the shop runs atcloud itself.
HOSTING_MODE=manual
# Venues get <name>.HOSTING_DOMAIN (the same domain as atcloud's ATCLOUD_DOMAIN).
HOSTING_DOMAIN=
# ssh mode only: a user on the hosting server allowed to run atcloud, and the shop's SSH key for it.
HOSTING_SSH=
HOSTING_SSH_KEY=
HOSTING_ATCLOUD=atcloud

# Where the downloads page sends people for the server and laptop app.
RELEASES_REPO=adam1991tom/AT-SUITE-releases
